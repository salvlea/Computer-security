{"nodes": [{"id": "capire_progetto_spiegazione_sandbox_llm", "label": "Sandbox LLM (spiegazione semplice)", "file_type": "concept", "source_file": "capire-progetto/spiegazione.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La sandbox e' la 'gabbia' isolata in cui far eseguire codice/azioni dell'LLM cosi' che il danno resti contenuto e non tocchi il sistema vero (file, rete, chiavi)."}, {"id": "capire_progetto_spiegazione_guardrail", "label": "Guardrail (spiegazione semplice)", "file_type": "concept", "source_file": "capire-progetto/spiegazione.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Controlla cosa l'LLM dice (il testo/linguaggio), non cosa fa; e' un filtro, non un contenimento delle azioni."}, {"id": "capire_progetto_spiegazione_docker_vs_kubernetes", "label": "Docker vs Kubernetes (scelta per la demo)", "file_type": "rationale", "source_file": "capire-progetto/spiegazione.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il problema e' isolare una singola esecuzione di codice non fidato (richiesta->container effimero->risultato->distruggi), esattamente il caso d'uso di Docker; Kubernetes risolve un problema diverso (orchestrare/scalare tanti container su piu' macchine) non necessario per una demo di sicurezza a singola esecuzione."}, {"id": "capire_progetto_spiegazione_docker", "label": "Docker", "file_type": "concept", "source_file": "capire-progetto/spiegazione.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_spiegazione_kubernetes", "label": "Kubernetes", "file_type": "concept", "source_file": "capire-progetto/spiegazione.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_spiegazione_docker_hardened", "label": "Docker hardened (--network none, --read-only, --cap-drop=ALL, non-root)", "file_type": "rationale", "source_file": "capire-progetto/spiegazione.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Secondo gradino del percorso di crescita consigliato: rafforza il Docker semplice con limiti di rete, filesystem read-only, capability minime e limiti CPU/RAM/tempo, prima di considerare gVisor."}, {"id": "capire_progetto_spiegazione_gvisor_runtime_runsc", "label": "gVisor come runtime Docker (--runtime=runsc)", "file_type": "concept", "source_file": "capire-progetto/spiegazione.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bonus opzionale: mostra un livello di isolamento superiore mantenendo la stessa interfaccia Docker, un confronto utile da mettere nel report."}], "edges": [{"source": "capire_progetto_spiegazione_sandbox_llm", "target": "capire_progetto_consigli_progetto_sandbox_llm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "capire-progetto/spiegazione.md", "source_location": null, "weight": 1.0}, {"source": "capire_progetto_spiegazione_guardrail", "target": "capire_progetto_consigli_progetto_guardrail", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "capire-progetto/spiegazione.md", "source_location": null, "weight": 1.0}, {"source": "capire_progetto_spiegazione_docker_vs_kubernetes", "target": "capire_progetto_consigli_progetto_scala_isolamento", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "capire-progetto/spiegazione.md", "source_location": null, "weight": 1.0}, {"source": "capire_progetto_spiegazione_docker_vs_kubernetes", "target": "capire_progetto_consigli_progetto_llm_sandbox_lib", "relation": "references", "confidence": "EXTRACTED", "con