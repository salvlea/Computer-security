{"nodes": [{"id": "capire_progetto_consigli_progetto_sandbox_llm", "label": "Sandbox LLM (scope progetto)", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Progetto individuale focalizzato esclusivamente sul contenimento delle AZIONI di un LLM/agente (esecuzione codice, tool-use), distinto dal guardrail che filtra il testo; lo scope A+B (esecuzione codice + azioni agente) \u00e8 scelto perche' e' dove esistono librerie open source reali da studiare e genera la demo piu' convincente."}, {"id": "capire_progetto_consigli_progetto_guardrail", "label": "Guardrail", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Citato solo come contesto concettuale per delimitare la sandbox: il guardrail filtra 'cosa l'LLM puo' dire' (proxy semantico input/output), mentre la sandbox contiene 'cosa l'LLM puo' fare'."}, {"id": "capire_progetto_consigli_progetto_threat_model", "label": "Threat Model", "file_type": "rationale", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spina dorsale del progetto: definire attore/origine minaccia, asset da proteggere, capacita' dell'attaccante e cosa la sandbox NON difende, per motivare in modo esplicito le scelte architetturali."}, {"id": "capire_progetto_consigli_progetto_owasp_top_10_llm", "label": "OWASP Top 10 for LLM Applications", "file_type": "document", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_mitre_atlas", "label": "MITRE ATLAS", "file_type": "document", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_prompt_injection", "label": "Prompt Injection", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_indirect_prompt_injection", "label": "Indirect Prompt Injection", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_confused_deputy", "label": "Confused Deputy", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_scala_isolamento", "label": "Scala di isolamento (livelli di sandboxing)", "file_type": "rationale", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordina i meccanismi di isolamento dal piu' debole (linguaggio) al piu' forte (microVM/WASM): piu' si scende nella scala, piu' le garanzie sono forti ma cresce il costo (latenza, complessita'). Il progetto sceglie un punto sulla scala e lo motiva."}, {"id": "capire_progetto_consigli_progetto_restrictedpython", "label": "RestrictedPython", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Isolamento a livello di linguaggio (debole): superfici di escape enormi (introspezione, getattr, escape noti) - utile per mostrare perche' non basta."}, {"id": "capire_progetto_consigli_progetto_seccomp_bpf", "label": "seccomp-bpf", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_apparmor_selinux", "label": "AppArmor / SELinux", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_linux_namespaces_cgroups", "label": "Linux namespaces + cgroups", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_docker_podman", "label": "Docker / Podman", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Isolamento pratico e riproducibile (medio-alto); con hardening (drop capabilities, network none, rootless, quota) e' un buon compromesso, ma condivide il kernel dell'host (una vuln kernel = escape)."}, {"id": "capire_progetto_consigli_progetto_gvisor", "label": "gVisor", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intercetta le syscall in user space riducendo la superficie del kernel host; usato da OpenAI/altri per code interpreter."}, {"id": "capire_progetto_consigli_progetto_firecracker", "label": "Firecracker", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MicroVM (AWS): isolamento hardware, ogni sessione in una micro-macchina virtuale; standard 'serio' per eseguire codice non fidato di terzi."}, {"id": "capire_progetto_consigli_progetto_kata_containers", "label": "Kata Containers", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_webassembly", "label": "WebAssembly (WASM)", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sandbox by design, capability-based, niente accesso al sistema salvo esplicita concessione; ottimo per codice deterministico e leggero (Pyodide, wasmtime, wasmer)."}, {"id": "capire_progetto_consigli_progetto_llm_sandbox_lib", "label": "llm-sandbox (vndee/llm-sandbox)", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Esegue codice generato da LLM in Docker/Podman/Kubernetes; diretto per il caso A (esecuzione codice), ottimo come base per la demo."}, {"id": "capire_progetto_consigli_progetto_e2b", "label": "E2B (e2b-dev)", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sandbox cloud per agenti AI basata su Firecracker microVM, SDK Python/JS; rappresenta lo stato dell'arte 'serio'."}, {"id": "capire_progetto_consigli_progetto_piston", "label": "Piston (engineer-man/piston)", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_judge0", "label": "Judge0", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_nsjail", "label": "nsjail (Google)", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_bubblewrap", "label": "bubblewrap (bwrap)", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_landlock", "label": "landlock (LSM)", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_nemo_guardrails", "label": "NVIDIA NeMo Guardrails", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_guardrails_ai", "label": "Guardrails AI", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_llm_guard", "label": "LLM Guard (protectai)", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_rebuff", "label": "Rebuff", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_llama_guard", "label": "Llama Guard (Meta)", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_langchain", "label": "LangChain", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_autogpt", "label": "AutoGPT", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_mcp", "label": "Model Context Protocol (MCP)", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_broker_policy_architecture", "label": "Architettura Broker / Policy Engine", "file_type": "rationale", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coerente con la metafora del prof (un LLM che ne invoca un altro) ma applicata alle azioni invece che al testo: un interceptor cattura le azioni, un policy engine decide se sono ammesse (rule-based, LLM-based o ibrido), e solo se approvate vengono eseguite nella sandbox; un auditor registra tutto."}, {"id": "capire_progetto_consigli_progetto_interceptor", "label": "Interceptor", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_policy_engine", "label": "Policy Engine (il decisore)", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Due modalita': rule-based (allow-list/deny pattern pericolosi) o LLM-based (secondo modello classifica safe/unsafe, pattern ricorsivo AI-che-controlla-AI); l'ibrido e' consigliato."}, {"id": "capire_progetto_consigli_progetto_sandbox_runtime", "label": "Sandbox Runtime", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_auditor_logger", "label": "Auditor / Logger", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "capire_progetto_consigli_progetto_demo_code_interpreter_sicuro", "label": "Demo: Code Interpreter sicuro", "file_type": "concept", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mostra il confronto 'senza sandbox' (danno) vs 'con sandbox' (contenuto) su una batteria di prompt malevoli (lettura file sensibili, esfiltrazione rete, comandi distruttivi, fork bomb); questo confronto trasforma un compitino in un progetto da lode."}, {"id": "capire_progetto_consigli_progetto_metriche_valutazione", "label": "Metriche di valutazione", "file_type": "rationale", "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Efficacia di sicurezza (% attacchi contenuti/bypassati), falsi positivi, overhead (latenza/risorse), copertura delle classi di minaccia del threat model; un progetto scientifico si misura."}], "edges": [{"source": "capire_progetto_consigli_progetto_sandbox_llm", "target": "richiesta_professore_progetto_sandbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "weight": 1.0}, {"source": "capire_progetto_consigli_progetto_guardrail", "target": "richiesta_professore_progetto_guardrail", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "weight": 1.0}, {"source": "capire_progetto_consigli_progetto_sandbox_llm", "target": "capire_progetto_consigli_progetto_guardrail", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "weight": 1.0}, {"source": "capire_progetto_consigli_progetto_guardrail", "target": "richiesta_professore_progetto_moscuza", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "weight": 1.0}, {"source": "capire_progetto_consigli_progetto_threat_model", "target": "capire_progetto_consigli_progetto_owasp_top_10_llm", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "weight": 1.0}, {"source": "capire_progetto_consigli_progetto_threat_model", "target": "capire_progetto_consigli_progetto_mitre_atlas", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "capire-progetto/consigli_progetto.md", "source_location": null, "weight": 1.0}, {"source": "capire_progetto_consigli_progetto_owasp_top_10_llm", "target": "capire_progetto_consigli_progetto_prompt_injection", "relation": "references", "confidence": "EXTRACTED", "confidence_score":