{"nodes": [{"id": "richiesta_professore_progetto_guardrail", "label": "Guardrail (definizione del professore)", "file_type": "concept", "source_file": "richiesta-professore/progetto.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il guardrail e' un proxy in input/output: se l'utente chiede come fare una bomba atomica, il guardrail non risponde; e' un filtro sul contenuto."}, {"id": "richiesta_professore_progetto_sandbox", "label": "Sandbox (definizione del professore)", "file_type": "concept", "source_file": "richiesta-professore/progetto.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La sandbox e' 'per l'esplosione interna, dalle viscere' - contenimento diverso dal guardrail ma concettualmente affine (stesso problema di contenimento visto da un altro lato)."}, {"id": "richiesta_professore_progetto_stato_dell_arte", "label": "Stato dell'arte (richiesta valutazione)", "file_type": "rationale", "source_file": "richiesta-professore/progetto.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il prof chiede di studiare librerie open source esistenti per guardrail e sandbox: 'ho trovato queste librerie e le posso usare' oppure motivare onestamente perche' non esistono."}, {"id": "richiesta_professore_progetto_ricorsivita_ai_che_controlla_ai", "label": "Ricorsivita' / AI che controlla AI", "file_type": "rationale", "source_file": "richiesta-professore/progetto.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Esempio del prof: un bot ChatGPT che prima di rispondere ne invoca un altro; e' il pattern di circolarita'/ricorsivita' (AI che aiuta per l'AI) da rendere come sandbox o guardrail a scelta dello studente."}, {"id": "richiesta_professore_progetto_moscuza", "label": "Moscuza (studente, tema guardrail)", "file_type": "concept", "source_file": "richiesta-professore/progetto.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "richiesta_professore_progetto_progetto_underspecified", "label": "Progetto underspecified (design intent del prof)", "file_type": "rationale", "source_file": "richiesta-professore/progetto.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il prof ammette esplicitamente che il progetto e' 'somewhat underspecified' perche' l'obiettivo e' costruire competenza, non risolvere un problema gia' completamente definito."}], "edges": [{"source": "richiesta_professore_progetto_guardrail", "target": "richiesta_professore_progetto_sandbox", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "richiesta-professore/progetto.txt", "source_location": null, "weight": 1.0}, {"source": "richiesta_professore_progetto_stato_dell_arte", "target": "richiesta_professore_progetto_guardrail", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "richiesta-professore/progetto.txt", "source_location": null, "weight": 1.0}, {"source": "richiesta_professore_progetto_stato_dell_arte", "target": "richiesta_professore_progetto_sandbox", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "richiesta-professore/progetto.txt", "source_location": null, "weight": 1.0}, {"source": "richiesta_professore_progetto_progetto_underspecified", "target": "richiesta_professore_progetto_sandbox", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "richiesta-professore/progetto.txt", "source_location": null, "weight": 1.0}, {"source": "richiesta_professore_progetto_ricorsivita_ai_che_controlla_ai", "target": "richiesta_prof